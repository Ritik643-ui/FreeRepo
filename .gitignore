# TravelBuddy - Comprehensive .gitignore

# ===========================
# Operating System Files
# ===========================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ===========================
# IDE and Editor Files
# ===========================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# ===========================
# Backend (Java/Spring Boot)
# ===========================

# Maven
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar

# Gradle
backend/.gradle
backend/build/
backend/!gradle/wrapper/gradle-wrapper.jar
backend/!**/src/main/**/build/
backend/!**/src/test/**/build/

# Spring Boot
backend/spring-boot-*.log
backend/application-*.properties
backend/application-*.yml
!backend/application.yml
!backend/application-dev.yml
!backend/application-prod.yml

# Java
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# ===========================
# Frontend (React/Expo)
# ===========================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Production builds
frontend/build/
frontend/dist/
frontend/web-build/

# Expo
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/.expo-shared/

# React Native
frontend/ios/build/
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/

# Metro
frontend/.metro-health-check*

# Testing
frontend/coverage/

# Misc
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/lerna-debug.log*

# ===========================
# Database
# ===========================

# PostgreSQL
*.sql.backup
*.dump
*.sql~

# H2 Database (for testing)
*.db
*.trace.db
*.lock.db

# ===========================
# Docker
# ===========================

# Docker volumes
docker-volumes/
.docker/

# ===========================
# AWS and Infrastructure
# ===========================

# Terraform
infrastructure/**/.terraform/
infrastructure/**/.terraform.lock.hcl
infrastructure/**/terraform.tfstate
infrastructure/**/terraform.tfstate.backup
infrastructure/**/terraform.tfvars
infrastructure/**/.terraformrc
infrastructure/**/terraform.rc

# AWS
.aws/
aws-exports.js

# CloudFormation
infrastructure/aws/packaged-template.yaml

# ===========================
# CI/CD
# ===========================

# Jenkins
.jenkins/

# GitHub Actions
.github/workflows/secrets/

# ===========================
# Security and Secrets
# ===========================

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# API Keys and Secrets
secrets/
*.pem
*.key
*.crt
*.p12
*.jks
keystore.properties

# JWT secrets
jwt-secret.txt

# ===========================
# Logs and Monitoring
# ===========================

# Application logs
logs/
*.log
*.log.*

# Monitoring
monitoring/data/

# ===========================
# Testing
# ===========================

# Test results
test-results/
coverage/
*.lcov
junit.xml

# E2E testing
tests/e2e/screenshots/
tests/e2e/videos/
tests/e2e/downloads/

# ===========================
# Documentation
# ===========================

# Generated documentation
docs/generated/
site/

# ===========================
# Temporary Files
# ===========================

# Temporary directories
tmp/
temp/
.tmp/
.temp/

# Cache directories
.cache/
.parcel-cache/

# ===========================
# Package Managers
# ===========================

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# pnpm
.pnpm-debug.log*

# ===========================
# Miscellaneous
# ===========================

# Backup files
*.backup
*.bak
*.orig

# Archive files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# ESLint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

